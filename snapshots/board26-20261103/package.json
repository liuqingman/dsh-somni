{
  "name": "dsh-somni",
  "version": "0.1.0",
  "description": "Sleep-consolidated memory for DeepSeek Harness: resident identity + intentions, action-time associative recall, episodic / semantic / prospective memory, and dream-time consolidation via a Python sidecar.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./examples/cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./examples/cordis.patch.yml"
    }
  },
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "python/pyproject.toml",
    "python/somni_memory/**/*.py",
    "python/somni_memory/prompts/*.md",
    "examples/**",
    "docs/**",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf lib",
    "test": "npm run test:py && npm run test:ts",
    "test:py": "cd python && python3 -m pytest tests -q",
    "test:ts": "npm run build && node tests/smoke_plugin.mjs",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "memory",
    "long-term-memory",
    "episodic-memory",
    "prospective-memory",
    "sleep-consolidation",
    "dream",
    "agent"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-agent": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-agent-default-model": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-home-paths": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-llm": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-session": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-subprocess": ">=0.0.1-rc.1",
    "@deepseek-ai/dsh-system-prompt": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-tools": "^0.2.0-rc.1"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-agent": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-agent-default-model": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-home-paths": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-llm": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-session": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-subprocess": ">=0.0.1-rc.1",
    "@deepseek-ai/dsh-system-prompt": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-tools": "^0.2.0-rc.1",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
